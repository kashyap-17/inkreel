# Copy to .env (git-ignored) and fill in. On Vercel, set the same names in the project's environment settings.

# Gemini API key from Google AI Studio.
GEMINI_API_KEY=

# Invite code testers type on the consent screen. Optional locally; required in production
# (without it the server refuses every model call).
INVITE_CODE=

# Langfuse tracing (not used yet).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
